{
  "name": "harmattan",
  "private": true,
  "version": "0.1.0",
  "description": "An AI treasury agent that pays African contractors in RLUSD on the XRP Ledger, inside limits the ledger enforces.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "probe": "tsx scripts/probe-ledger.ts",
    "status": "tsx scripts/status.ts",
    "agent": "tsx agent/src/run.ts",
    "topup": "tsx scripts/treasury-topup.ts",
    "limits": "tsx limits/src/server.ts",
    "seed": "tsx scripts/seed-payables.ts",
    "operator": "tsx scripts/operator.ts",
    "refusals": "tsx scripts/refusals.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.98",
    "ai": "^7.0.164",
    "dotenv": "^18.0.9",
    "ripple-binary-codec": "^2.11.0",
    "ripple-keypairs": "^3.1.0",
    "xrpl": "^5.3.0",
    "zod": "^4.6.7"
  }
}
