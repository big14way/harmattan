# Everything runs without credentials on XRPL Testnet. Copy to .env and fill in only what you have.

# testnet (default) or devnet
XRPL_NETWORK=testnet

# Claude plans the agent's runs when this is set; without it the deterministic rules planner runs.
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5. Larger models (claude-sonnet-5-5, claude-opus-5-5) also get server-side fallbacks.
# HARMATTAN_MODEL=claude-haiku-5-5

# Where the agent finds the limits service.
LIMITS_URL=http://localhost:8787

# Operator token for PUT /policy. If unset, the limits service generates one in .data/<network>/keys/.
HARMATTAN_OPERATOR_TOKEN=

# Keys default to .data/<network>/keys/<role>.json (created by pnpm setup:testnet).
# On a host, give each process only its own key:
# HARMATTAN_AGENT_SEED=
# HARMATTAN_LIMITS_SEED=
# HARMATTAN_OPERATOR_SEED=
# HARMATTAN_TREASURY_SEED=
