# Everything runs without credentials on XRPL Testnet. Copy to .env and fill in only what you have.

# testnet (default) or devnet
XRPL_NETWORK=testnet

# Claude plans the agent's runs when this is set; without it the deterministic rules planner runs.
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5. Larger models (claude-sonnet-5-5, claude-opus-5-5) also get server-side fallbacks.
# HARMATTAN_MODEL=claude-haiku-5-5

# Daily scheduled payout in the operator's time zone, e.g. 09:00. Unset: the agent runs when started.
# HARMATTAN_AGENT_SCHEDULE=09:00

# Where the services find each other (defaults shown).
# LIMITS_URL=http://localhost:8787
# AGENT_URL=http://localhost:8788

# Tokens: if unset, generated once into .data/<network>/keys/. The operator token changes policy and
# resolves approvals; the agent trigger token only starts agent runs (the agent never gets the former).
# HARMATTAN_OPERATOR_TOKEN=
# HARMATTAN_AGENT_TRIGGER_TOKEN=

# Hosted dashboard: HTTP basic auth password (any user name), entered at /signin. Payee pages and
# invite links stay public.
# HARMATTAN_DASHBOARD_PASSWORD=
# With a password set, 1 lets visitors open the console and run the demo: run payouts, approve up to
# 40 RLUSD, instruct the agent; at most 123 RLUSD a day leaves the treasury (read from the ledger).
# Limits, payees and invites stay operator-only.
# HARMATTAN_PUBLIC_DEMO=1

# Shown to payees on their page and in receipts, e.g. "Adebayo & Co, Lagos".
# HARMATTAN_COMPANY_NAME=
# Public base URL of the dashboard, used in receipt links (Render sets RENDER_EXTERNAL_URL).
# HARMATTAN_PUBLIC_URL=

# WhatsApp receipts through the Twilio WhatsApp sandbox. Without these, receipts are saved, not sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+<the sandbox number Twilio shows you>
# HARMATTAN_OPERATOR_WHATSAPP=+<your number, international format>

# Keys default to .data/<network>/keys/<role>.json (created by pnpm setup:testnet).
# On a host, give each process only its own key:
# HARMATTAN_AGENT_SEED=
# HARMATTAN_LIMITS_SEED=
# HARMATTAN_OPERATOR_SEED=
# HARMATTAN_TREASURY_SEED=   (setup and top-up scripts only; never needed by the running services)
